# Root .env — loaded by `npm run cli` (tsx --env-file=.env).
# Copy to .env and run `docker compose up -d` so `infra check` can reach local Mongo/SQS.

# MongoDB (matches apps/api + apps/worker .env.example)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=seo

# SQS / ElasticMQ (local; leave SQS_ENDPOINT empty to use real AWS)
SQS_ENDPOINT=http://localhost:9324
SCAN_QUEUE_URL=http://localhost:9324/000000000000/scan-queue

# API (the CLI's infra probe reads this)
API_URL=http://localhost:8787
