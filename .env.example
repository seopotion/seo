# Root .env — shared backend config, cascaded into api, worker, and the CLI.
# Each Node app's dev script loads this FIRST, then its own apps/<app>/.env
# (if present) which overrides any value here. Copy to .env and run
# `docker compose up -d` so local Mongo/SQS are reachable.
#
# Apps only read the variables they need: the worker ignores JWT_SECRET /
# GOOGLE_CLIENT_ID, the CLI ignores the auth vars, etc. Unused vars are harmless.
# The web app does NOT read this file — see apps/web/.env.example.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=seo

# SQS / ElasticMQ (local; leave SQS_ENDPOINT empty to use real AWS)
SQS_ENDPOINT=http://localhost:9324
SCAN_QUEUE_URL=http://localhost:9324/000000000000/scan-queue
GENERATION_QUEUE_URL=http://localhost:9324/000000000000/generation-queue
IMAGES_QUEUE_URL=http://localhost:9324/000000000000/images-queue
PUBLISH_QUEUE_URL=http://localhost:9324/000000000000/publish-queue

# API base URL (the CLI's infra probe reads this)
API_URL=http://localhost:8787

# Auth (read by the API only)
# Local dev signing secret. In deployed envs this is ignored: the API reads the
# secret from an SSM SecureString named by JWT_SECRET_PARAM instead (see infra).
JWT_SECRET=dev-secret-change-me
# Leave unset locally. Deployed envs set this to the SSM SecureString name (e.g.
# /seo/jwt-secret) so the secret is fetched + cached at runtime, never inlined.
# JWT_SECRET_PARAM=
# Google OAuth client id — must match apps/web's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Google OAuth client secret — the GSC connect flow's code exchange (#12).
# Same OAuth client as GOOGLE_CLIENT_ID. Deployed envs use an SSM SecureString
# named by GOOGLE_CLIENT_SECRET_PARAM instead (see infra).
GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_SECRET_PARAM=
# Secrets-at-rest encryption key: 32 bytes base64 (`openssl rand -base64 32`).
# Named for its first user (GSC refresh tokens, #12) but now also encrypts the
# WordPress token on the integrations collection (#7), so connecting WordPress
# locally needs it set. Deployed envs use an SSM SecureString named by
# GSC_TOKEN_KEY_PARAM instead.
GSC_TOKEN_KEY=
# GSC_TOKEN_KEY_PARAM=
# Web app origin — builds the GSC OAuth redirect URI. Defaults to
# http://localhost:3000; deployed envs set the real web origin.
# WEB_ORIGIN=

# GitHub App — static-site publishing credentials (#7, design/github-app.md).
# One App per environment; local dev gets its own (GitHub accepts an
# http://localhost Setup URL). Slug and client id are public.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
# The PKCS#1 PEM from the App's settings, on one line with literal \n escapes
# (they are unescaped on read). Deployed envs leave this unset and resolve an
# SSM SecureString named by GITHUB_APP_KEY_PARAM instead, written with
# `--value file://key.pem` so the real newlines survive.
GITHUB_APP_KEY=
# GITHUB_APP_KEY_PARAM=

# LemonSqueezy billing (read by the API only, #13). Local dev: set the plain
# secrets below. Deployed envs leave them unset and instead resolve SSM
# SecureStrings named by *_PARAM (see infra). Store + variant ids are public,
# per-env values from the LemonSqueezy dashboard.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# LEMONSQUEEZY_API_KEY_PARAM=
# LEMONSQUEEZY_WEBHOOK_SECRET_PARAM=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PAID=
LEMONSQUEEZY_VARIANT_EXPERT=

# DataForSEO (read by the API + worker when keyword research is wired in).
# Local dev: set the plain login/password below. Deployed envs leave these
# unset and instead resolve SSM SecureStrings named by *_PARAM (see infra).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_LOGIN_PARAM=
# DATAFORSEO_PASSWORD_PARAM=

# OpenRouter (LLM) + fal.ai (image) — read by the worker when generation is wired
# in (epic #56). Local dev: set the plain keys below. Deployed envs leave these
# unset and instead resolve SSM SecureStrings named by *_PARAM (see infra, #55/#51).
OPENROUTER_API_KEY=
FAL_KEY=
YOUTUBE_API_KEY=
# OPENROUTER_API_KEY_PARAM=
# FAL_KEY_PARAM=

# Images S3/CloudFront (deployed only — set by CDK on the images worker Lambda).
# Leave unset locally: the worker then stores the provider URL directly (dev fallback).
# IMAGES_BUCKET=
# IMAGES_CDN_DOMAIN=

# Admin API (read by the admin app only, epic #150)
# Local dev admin signing secret — must differ from JWT_SECRET so customer and
# admin tokens can never validate against each other. Deployed envs use an SSM
# SecureString named by ADMIN_JWT_SECRET_PARAM instead (see infra).
ADMIN_JWT_SECRET=dev-admin-secret-change-me
# Comma-separated operator email allowlist (local dev). Deployed envs use a
# plain SSM String parameter named by ADMIN_OPERATORS_PARAM instead.
ADMIN_OPERATORS=
# ADMIN_JWT_SECRET_PARAM=
# ADMIN_OPERATORS_PARAM=
# Local admin dev server port (dev.ts). Defaults to 8788.
# ADMIN_PORT=8788
