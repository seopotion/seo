{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "packages/shared/*/src/**/*",
    "packages/shared/*/tests/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "infra",
    "cdk.out",
    // Browser app with its own DOM/JSX tsconfig — `npm run check:admin` covers
    // it. (apps/web needs no entry here only because it has no src/ directory.)
    "apps/admin"
  ]
}
