{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/*/src/**/*",
    "apps/*/tests/**/*",
    "packages/shared/*/src/**/*",
    "packages/shared/*/tests/**/*",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    "infra",
    "cdk.out",
    // Browser apps with their own tsconfigs (including their test files) — run via
    // `npm run check:admin` and `npm run check:web` respectively.
    "apps/admin",
    "apps/web"
  ]
}
