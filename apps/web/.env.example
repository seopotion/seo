# Public API base URL (API Gateway URL in deployed envs).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Canonical public site URL used for metadata, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://seopotion.com

# Google OAuth client id for "Sign in with Google" (must match the API's GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only Supabase credentials for wishlist signup collection.
# Use the project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=
SUPABASE_SECRET_KEY=
