# Public API base URL (API Gateway URL in deployed envs).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Google OAuth client id for "Sign in with Google". Must match GOOGLE_CLIENT_ID
# in the root /.env (the backend). Re-declared here because Next.js loads its own
# env from apps/web and only NEXT_PUBLIC_* vars may reach the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
