# Admin API base URL. The URL IS the environment (design/admin-panel.md §4) —
# there is no ambient stage config, and the app banners whatever this points at.
# Local: the api dev server's admin port. Deployed: the AdminHttpApiUrl CfnOutput.
VITE_ADMIN_API_URL=http://localhost:8788

# Google OAuth client id for operator sign-in. Same public client id apps/web
# uses (NEXT_PUBLIC_GOOGLE_CLIENT_ID) — it must match GOOGLE_CLIENT_ID in the
# root /.env, since the admin API verifies ID tokens against that audience.
VITE_GOOGLE_CLIENT_ID=

# Vite only exposes VITE_-prefixed vars to the browser bundle. Secrets never go
# in this file — the operator allowlist and admin JWT secret are server-side.

# --- Pointing at a deployed backend ---
#
# `npm run dev -w admin` reads .env.local (local API). `npm run dev:staging -w
# admin` additionally reads .env.staging, which Vite loads AFTER .env.local and
# so overrides it — put the staging AdminHttpApiUrl there and the two commands
# become the environment switch. The red REMOTE banner is the confirmation.
#
#   # apps/admin/.env.staging (gitignored, public values only)
#   VITE_ADMIN_API_URL=https://<admin-api-id>.execute-api.us-east-1.amazonaws.com
#   VITE_GOOGLE_CLIENT_ID=<same id — GOOGLE_CLIENT_ID_STAGING matches the local one>
#
# Staging talks to the seo_staging database: different orgs, different ids.
